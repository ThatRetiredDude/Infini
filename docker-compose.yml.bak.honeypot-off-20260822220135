services:
  infini:
    build: .
    container_name: infini
    restart: unless-stopped
    ports:
      - "127.0.0.1:${HOST_PORT:-3000}:3000"
      # Cowrie honeypot (SSH on 2222, Telnet on 2223) — enabled by default via INFINI_NETWORK_HONEYPOT_ENABLED=1.
      # Change host side ports if they conflict on your host.
      - "${HOST_SSH_HONEYPOT_PORT:-2222}:2222"
      - "${HOST_TELNET_HONEYPOT_PORT:-2223}:2223"
    env_file:
      - .env
    environment:
      - NODE_ENV=production
      - PORT=3000
      - DATABASE_FILE=/data/infini.sqlite
      - UPLOADS_DIR=/data/uploads
      - ACCESS_LOG_CSV_DIR=/data/logs
      - COWRIE_HOME=/data/cowrie
      - COWRIE_INSTALL_DIR=/opt/cowrie-install
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://localhost:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 90s
    volumes:
      - infini-data:/data
    networks:
      - infini_app

  # Network banner + full MySQL honeypot sidecar.
  # FTP (21) + Postgres banner (5432) + MySQL pharma trap (3306 or random).
  # Isolated from real Infini app network (Phase 2 lockdown).
  honeypot-sidecar:
    build: ./sidecar
    container_name: infini-sidecar
    restart: unless-stopped
    ports:
      - "21:21"
      # MySQL honeypot (pharma infinite maze + password hashes).
      # Dev/testing: use high random port (e.g. 33306) via MYSQL_HONEYPOT_PORT=33306
      # Production lure: set MYSQL_HONEYPOT_PORT=3306 AFTER moving real MySQL to 33306 (see docs/honeypot-mysql-pharma.md)
      - "${MYSQL_HONEYPOT_PORT:-33306}:3306"
      - "5432:5432"
    networks:
      - infini_honeypot

volumes:
  infini-data:
    driver: local

networks:
  infini_app:
    name: infini_app
  infini_honeypot:
    name: infini_honeypot
