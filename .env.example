# ─── InfiniPot environment ────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Used in blog publish webhooks for absolute links when not passed in payload
PUBLIC_SITE_ORIGIN=http://localhost:3000

# Set to 1 in tests or local dev to silence the alert cron loop
DISABLE_SECURITY_ALERT_SCHEDULER=0

# ─── Database (SQLite) ────────────────────────────────────────────────────────
# Path inside the container (or relative to the project root in dev).
DATABASE_FILE=./data/infinipot.sqlite

# ─── Auth ─────────────────────────────────────────────────────────────────────
# 32+ random chars. Generate: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-please-this-must-be-long-and-random
JWT_EXPIRES_IN=7d
COOKIE_NAME=mi_session
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Seed admin (created on first boot if no users exist).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMeImmediately!
SEED_ADMIN_EMAIL=admin@example.com

# ─── Encryption for stored integration credentials ────────────────────────────
# 64 hex chars = 32 bytes. Used to encrypt API keys (ipinfo, AbuseIPDB, GreyNoise, xAI, …)
# stored in the integrations table. Generate: `openssl rand -hex 32`
INTEGRATION_ENCRYPTION_KEY=

# ─── Monitored Data Room Access ───────────────────────────────────────────────
# Cloudflare Turnstile (challenges repeat data-room visitors). Optional — recommended.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── AI Input Guard ───────────────────────────────────────────────────────────
AI_GUARD_HIGH_REVOKE_THRESHOLD=3
AI_GUARD_IP_DENSITY_THRESHOLD=20

# ─── AI Log Review (repurposed AI Brief) ──────────────────────────────────────
# xAI is the only supported provider. Default model is `grok-4.3-latest`,
# with `grok-latest` as a fast fallback. The active key may be stored
# encrypted in the integrations table via the admin UI instead of here.
XAI_API_KEY=
AI_LOG_REVIEW_MODEL=grok-4.3-latest
AI_LOG_REVIEW_FALLBACK_MODEL=grok-latest

# ─── Blog cross-post / publish hooks (optional) ──────────────────────────────
# Prefer BLOG_PUBLISH_* ; legacy BLOG_DEPLOY_* aliases are also read in server/blog.js.
BLOG_PUBLISH_WEBHOOK_URL=
BLOG_PUBLISH_WEBHOOK_SECRET=

# ─── Mail (used by the alerts engine, when sending via email) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Misc ─────────────────────────────────────────────────────────────────────
# CSV log mirrored alongside the access_log table (for offline / grep workflows).
ACCESS_LOG_CSV_DIR=./data/logs
