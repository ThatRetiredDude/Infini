# ─── Infini environment ────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Used in blog publish webhooks for absolute links when not passed in payload
PUBLIC_SITE_ORIGIN=http://localhost:3000

# Set to 1 in tests or local dev to silence the alert cron loop
DISABLE_SECURITY_ALERT_SCHEDULER=0

# ─── Database (SQLite) ────────────────────────────────────────────────────────
# Local dev: path under the repo. Docker Compose overrides to /data/infini.sqlite in the container.
DATABASE_FILE=./data/infini.sqlite

# ─── Docker-only danger (dev/lab) ──────────────────────────────────────────────
# Wipes DATABASE_FILE (+ -wal/-shm) once before seed — requires BOTH set exactly.
# Remove after use. Never automatic with JWT/integration secret generation.
# INFINI_RESET_DATABASE=1
# INFINI_CONFIRM_DATABASE_RESET=YES

# ─── Auth ─────────────────────────────────────────────────────────────────────
# 32+ random chars. Generate: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# Docker: if unset/too short, entrypoint generates and persists under /data/.secrets/jwt_secret on the volume.
JWT_SECRET=change-me-please-this-must-be-long-and-random
JWT_EXPIRES_IN=7d
COOKIE_NAME=mi_session
# Optional; default mi_csrf. If changed, set VITE_CSRF_COOKIE_NAME for the SPA build.
# CSRF_COOKIE_NAME=mi_csrf
COOKIE_DOMAIN=
# false | true | auto  (auto = Secure when X-Forwarded-Proto/https)
COOKIE_SECURE=false
# lax (default) | strict | none (none requires Secure cookies)
COOKIE_SAMESITE=lax

# Behind TLS termination: redirect HTTP→HTTPS and rely on forwarded proto for cookies.
# ENFORCE_HTTPS=true

# Browser CORS: comma-separated origins. Dev defaults include localhost:5173 and :3000.
# Production: set explicitly or rely on PUBLIC_SITE_ORIGIN / PUBLIC_BASE_URL as a single allowed origin.
# CORS_ORIGINS=https://example.com,https://www.example.com

# Issuer label in authenticator apps (Security hub → 2FA).
# MFA_ISSUER=Infini

# Seed admin (created on first boot if no admin exists; idempotent seed also runs via Docker entrypoint).
# Username / email identify the account; password is bcrypt-hashed — never stored in plaintext in SQLite.
#
# SEED_ADMIN_PASSWORD — optional:
# If unset or empty, the documented bootstrap is ChangeMeImmediately! (see README / docs/configuration.md). Set this to override; still bcrypt-hashed. First sign-in forces a new password in the SPA.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# One-shot recovery: forces bcrypt reset for existing admin to SEED_ADMIN_PASSWORD (or bootstrap if empty).
# SEED_ADMIN_OVERWRITE_PASSWORD=1
SEED_ADMIN_EMAIL=admin@example.com

# ─── Encryption for stored integration credentials ────────────────────────────
# 64 hex chars = 32 bytes. Used to encrypt API keys (ipinfo, AbuseIPDB, GreyNoise, xAI, …)
# stored in the integrations table. Generate: `openssl rand -hex 32`
# Docker: if unset/invalid, entrypoint generates and persists under /data/.secrets/integration_encryption_key on the volume.
INTEGRATION_ENCRYPTION_KEY=

# Cowrie network honeypot (SSH on 2222, Telnet on 2223) — enabled by default.
# Tails Cowrie JSON logs into SQLite, exposes honeypot metadata on /api/health, and enables Security Hub → Network sensor.
# Requires the Docker image (bundles Cowrie). Set to 0 to disable.
INFINI_NETWORK_HONEYPOT_ENABLED=1
#
# Docker Compose maps 2222→SSH and 2223→Telnet honeypot by default (HOST_*_HONEYPOT_PORT). Override if busy.
# Cowrie config and state live on the volume under /data/cowrie (COWRIE_HOME). Cowrie is GPL-2.0 — see docs/honeypot-cowrie.md.
# COWRIE_TELNET_ENABLED=0
# Cowrie download artifact retention (best-effort sweep, days)
# COWRIE_ARTIFACT_RETENTION_DAYS=14
# Override JSON log path if Cowrie output is non-default (otherwise inferred from COWRIE_HOME)
# COWRIE_JSON_LOG=/data/cowrie/var/log/cowrie/cowrie.json

# ─── Monitored Data Room Access ───────────────────────────────────────────────
# Cloudflare Turnstile (challenges repeat data-room visitors). Optional — recommended.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── AI Input Guard ───────────────────────────────────────────────────────────
AI_GUARD_HIGH_REVOKE_THRESHOLD=3
AI_GUARD_IP_DENSITY_THRESHOLD=20

# ─── AI Log Review (repurposed AI Brief) ──────────────────────────────────────
# xAI is the only supported provider. Default model is `grok-4.3-latest`,
# with `grok-latest` as a fast fallback. The active key may be stored
# encrypted in the integrations table via the admin UI instead of here.
XAI_API_KEY=
AI_LOG_REVIEW_MODEL=grok-4.3-latest
AI_LOG_REVIEW_FALLBACK_MODEL=grok-latest

# ─── Blog cross-post / publish hooks (optional) ──────────────────────────────
# Prefer BLOG_PUBLISH_* ; legacy BLOG_DEPLOY_* aliases are also read in server/blog.js.
BLOG_PUBLISH_WEBHOOK_URL=
BLOG_PUBLISH_WEBHOOK_SECRET=

# ─── Mail (used by the alerts engine, when sending via email) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Misc ─────────────────────────────────────────────────────────────────────
# CSV log mirrored alongside the access_log table (for offline / grep workflows).
ACCESS_LOG_CSV_DIR=./data/logs
